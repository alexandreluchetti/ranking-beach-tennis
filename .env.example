# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Values marked SECRET must be unique and strong on the server.

# --- Database (local development and server) -------------------------------------------
POSTGRES_DB=ranking
POSTGRES_USER=ranking
# SECRET on the server. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=ranking
POSTGRES_PORT=5432

# --- API (docker compose --profile local or --profile prod) ------------------------------
# Server only: public name of the API, pointing (DNS A record) to the server, e.g. api.example.com.br
DOMAIN=localhost
# Firebase UID of the single administrator (Firebase console -> Authentication -> Users).
ADMIN_AUTH_SUBJECT=
FIREBASE_PROJECT_ID=ranking-beach-tennis
# Web app origins allowed to call the API (comma-separated, exact scheme://host[:port]).
# Locally, use http://localhost:5000 (flutter run -d chrome --web-port 5000).
CORS_ALLOWED_ORIGINS=https://ranking-beach-tennis.web.app,https://ranking-beach-tennis.firebaseapp.com
# Keep false in production (hides Swagger / OpenAPI); true is handy locally.
API_DOCS_ENABLED=false
# Push needs the SECRET service account key at ./secrets/firebase-service-account.json.
PUSH_FCM_ENABLED=false
# Days of daily database dumps kept in ./backups.
BACKUP_KEEP_DAYS=14
# Local API port (--profile local). Bound to 127.0.0.1 only.
API_PORT=8080
